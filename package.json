{
  "name": "mochi-desktop-companion",
  "version": "1.0.0",
  "description": "Mochi Desktop Companion - Animated AI Orb & Personal Productivity Assistant",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "cross-env NODE_ENV=development vite build --config vite.main.config.ts --watch",
    "dev:electron": "wait-on http://localhost:5173 dist/main/main.js && electron dist/main/main.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "vite build --config vite.main.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "start": "cross-env NODE_ENV=production electron dist/main/main.js"
  },
  "build": {
    "appId": "com.mochi.desktopcompanion",
    "productName": "Mochi Desktop Companion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "mochi-desktop",
      "repo": "mochi"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "synopsis": "Ambient desktop companion and personal productivity assistant"
    }
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "ai-orb",
    "productivity",
    "pomodoro",
    "threejs"
  ],
  "author": "Mochi Companion Team",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.2"
  }
}
